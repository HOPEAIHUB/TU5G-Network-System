# TUGS Gateway System — Environment Variables
# Copy to .env and fill with real values. NEVER commit .env.

# JWT Keys (base64-encoded RSA keys, RS512)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# gRPC TLS Certificates (base64-encoded)
GRPC_ROOT_CA=
GRPC_CLIENT_KEY=
GRPC_CLIENT_CERT=

# HAG — Cloudflare IP reputation
CLOUD_FLARE_API=

# HMAIL — SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DKIM_PRIVATE_KEY=
DKIM_SELECTOR=
DKIM_DOMAIN=

# TUGS Gateway URL
TUGS_GATEWAY_URL=https://tugs.tu5g.online/api/v1
