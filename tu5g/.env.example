# ==============================================================================
# TU5G PLATFORM CONFIGURATION ENVIRONMENT VARIABLES
# Copy this file to '.env' and modify the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (Should be a high-entropy string of at least 32 bytes)
# Run `openssl rand -hex 32` to generate one
JWT_SECRET=CHANGE_ME
# Algorithm used for JWT signatures
ALGORITHM=HS256
# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL Async Connection URL
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://tu5g:CHANGE_ME@postgres:5432/tu5g
POSTGRES_USER=tu5g
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tu5g

# ------------------------------------------------------------------------------
# 3. ARTIFICIAL INTELLIGENCE & COGNITIVE SERVICES (LLMs)
# ------------------------------------------------------------------------------
# LLM Provider selection: 'openai', 'anthropic', or 'azure'
LLM_PROVIDER=openai

# OpenAI settings
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI settings (required only if LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Anthropic (Claude) settings (required only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE CONFIGURATION (MINIO / S3)
# ------------------------------------------------------------------------------
# Endpoint for MinIO (locally) or S3 (production)
MINIO_ENDPOINT=minio:9000
# Access Key (MinIO Root User in docker-compose)
MINIO_ACCESS_KEY=tu5g_admin
# Secret Key (MinIO Root Password in docker-compose)
MINIO_SECRET_KEY=CHANGE_ME
# Use SSL/TLS for MinIO connection (false for local development, true for production with HTTPS)
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 5. COMMUNICATIONS (EMAIL & TELEMETRY)
# ------------------------------------------------------------------------------
# SMTP configuration for outbound email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@tu5g-platform.com
SMTP_PASSWORD=your_smtp_app_password

# IMAP configuration for inbound email processing
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ------------------------------------------------------------------------------
# 6. IOT / TELEMETRY (MQTT)
# ------------------------------------------------------------------------------
# MQTT Broker details for real-time SIM and Core telemetry
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=tu5g/telemetry

# ------------------------------------------------------------------------------
# 7. REDIS CONFIGURATION (Caching and Rate Limiting)
# ------------------------------------------------------------------------------
# Redis connection URL
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 8. NETWORK & INTEGRATIONS
# ------------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated list, no spaces)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost

# Global API Rate limit per minute per IP
RATE_LIMIT=10

# ------------------------------------------------------------------------------
# 9. TELECOMMUNICATIONS SYSTEM DEFAULT CARRIER SETTINGS
# ------------------------------------------------------------------------------
# Mobile Country Code (MCC) - Default: 984 (TU5G Reserved Test MCC)
DEFAULT_MCC=984
# Mobile Network Code (MNC) - Default: 79 (TU5G Core Segment MNC)
DEFAULT_MNC=79
